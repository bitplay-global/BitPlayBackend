    {
      "name": "8) GET user withdrawals",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-app-id", "value": "bitplay-mobile" },
          { "key": "x-app-platform", "value": "ios" },
          { "key": "x-app-version", "value": "1.0.0" },
          { "key": "x-device-id", "value": "postman-12345678" },
          { "key": "x-mobile-client", "value": "true" }
        ],
        "url": "{{baseUrl}}/api/withdrawals/user/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns array', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(Array.isArray(json)).to.eql(true);",
              "});"
            ]
          }
        }
