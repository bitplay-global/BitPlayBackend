  ],
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('userId')) {",
          "  console.warn('Set environment variable userId before running this collection.');",
          "}",
          "if (!pm.environment.get('speedAddress')) {",
          "  console.warn('Set environment variable speedAddress (example: alice@speed.app).');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://dashboard.bitplaypro.com" },
    { "key": "userId", "value": "69f974ca88ca0fdc966e23a4" },
    { "key": "speedAddress", "value": "srjahir32@speed.app" },
    { "key": "speedPaymentAmountBtc", "value": "0.0008" },
