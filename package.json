{
  "name": "admin-panel",
  "version": "1.0.0",
  "description": "Admin Panel for Bitcoin Mining App",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "cron:selected-hourly": "node testCronSelectedUsersHourly.js",
    "build": "npm install",
    "deploy": "npm run build && npm start",
    "check:payouts": "node scripts/check-payout-guards.js",
    "prepush": "sh scripts/security-checks.sh",
    "test:withdrawals": "node tests/withdrawal-security.test.mjs",
    "test:privileges": "node tests/privilege-verification.test.mjs",
    "test:deposits": "node tests/deposit-address-keys.test.mjs",
    "test:app-auth": "JWT_LIB_DIR=../bitplay-auth node tests/app-user-auth.test.mjs",
    "test:purchases": "node tests/purchase-verification.test.mjs",
    "test:revenuecat": "node tests/revenuecat-webhook.test.mjs",
    "test:dashboard-stats": "node tests/dashboard-stats-privileges.test.mjs",
    "check:models": "node scripts/check-model-indexes.js",
    "check:security": "sh scripts/security-checks.sh"
  },
  "keywords": [
    "admin",
    "dashboard",
    "nodejs",
    "express",
    "ejs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bip32": "^5.0.0-rc.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.7",
    "body-parser": "^2.2.0",
    "bullmq": "^5.58.4",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "ecpair": "^3.0.0",
    "ejs": "^3.1.9",
    "ethers": "^6.15.0",
    "express": "^4.21.2",
    "express-session": "^1.17.3",
    "firebase-admin": "^13.6.0",
    "google-auth-library": "^9.0.0",
    "helmet": "^7.0.0",
    "inquirer": "^12.9.4",
    "ioredis": "^5.7.0",
    "lightning-client": "^0.5.2-beta.8",
    "mongoose": "^8.16.4",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "sib-api-v3-sdk": "^8.5.0",
    "tiny-secp256k1": "^2.2.4",
    "uuid": "^11.1.0",
    "wif": "^5.0.0",
    "ws": "^8.18.0",
    "zeromq": "^6.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
