<%- include('partials/header', { title }) %>
  <%- include('partials/sidebar', { user }) %>

    <style>
      .history-tab-link {
        border-radius: 0;
        border-bottom: 3px solid transparent;
        background: none;
        border-top: none;
        border-left: none;
        border-right: none;
        padding: 10px 18px;
        color: var(--bs-body-color);
        font-size: 0.95rem;
      }

      .history-tab-link.active {
        border-bottom-color: #0d6efd;
        color: #0d6efd;
        font-weight: 600;
      }

      .history-tab-link:hover:not(.active) {
        color: #0d6efd;
      }

      .game-pill,
      .mining-pill {
        border-radius: 20px;
        font-size: 0.82rem;
      }

      #histTableWrap {
        overflow-x: auto;
      }

      .hist-spinner {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 40px 16px;
        color: var(--bs-secondary-color, #adb5bd);
      }

      .hist-empty {
        padding: 40px 0;
        text-align: center;
        color: var(--bs-secondary-color, #adb5bd);
      }
    </style>

    <div class="main-content">
      <div class="card-container">
        <div class="cards">

          <!-- Header: title + search -->
          <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h2 id="histTitle">History</h2>
            <div class="d-flex align-items-center gap-2">
              <input type="text" id="userSearch" class="form-control" placeholder="Search by name or email…"
                style="max-width:250px;" />
              <button class="btn btn-outline-secondary btn-sm" id="histSearchClear" style="display:none;"
                title="Clear search">
                <i class="fas fa-times"></i>
              </button>
            </div>
          </div>

          <!-- Tab bar -->
          <div class="d-flex align-items-center border-bottom mb-0 px-2 pt-1 gap-1 flex-wrap"
            style="background:rgba(0,0,0,.15);">
            <button class="history-tab-link active" data-tab="streak">
              <i class="fas fa-fire text-danger me-1"></i>Streak History
            </button>
            <button class="history-tab-link" data-tab="game">
              <i class="fas fa-gamepad text-warning me-1"></i>Game History
            </button>
            <button class="history-tab-link" data-tab="mining">
              <i class="fas fa-microchip text-success me-1"></i>Mining History
            </button>

            <!-- Game sub-tabs (shown only on Game tab) -->
            <div id="gameSubTabs" class="ms-3 d-flex gap-1" style="display:none!important;">
              <button class="btn btn-sm btn-primary game-pill" data-gtype="trading"><i
                  class="fas fa-chart-line me-1"></i>Trading</button>
              <button class="btn btn-sm btn-outline-warning game-pill" data-gtype="spin"><i
                  class="fas fa-dharmachakra me-1"></i>Spin</button>
              <button class="btn btn-sm btn-outline-info game-pill" data-gtype="memory"><i
                  class="fas fa-brain me-1"></i>Memory</button>
            </div>

            <!-- Mining sub-tabs removed; only Balance History remains -->

            <span id="histCount" class="ms-auto small text-muted py-2"></span>
          </div>

          <!-- Table -->
          <div class="table-responsive data-table" id="histTableWrap">
            <div class="hist-spinner">
              <div class="spinner-border spinner-border-sm" role="status"></div> Loading…
            </div>
          </div>

          <!-- Pagination -->
          <div class="pagination mt-3 d-flex align-items-center" id="histPagination"></div>

        </div><!-- /.cards -->
      </div><!-- /.card-container -->
    </div><!-- /.main-content -->

    <script>
      (function () {
        'use strict';

        /* ── state ─────────────────────────────────────────────────────── */
        let state = { tab: 'streak', gameType: 'trading', miningType: 'balance', page: 1, limit: 20, q: '' };
        let debounceTimer = null;

        /* ── column headers ─────────────────────────────────────────────── */
        const COLS = {
          streak: ['#', 'User Name', 'Email', 'Streak Days', 'Last Active Date', 'Last Updated'],
          trading: ['#', 'User', 'Email', 'Direction', 'Duration', 'Entry Price', 'Exit Price', 'Result', 'Reward (Gh)', 'Status', 'Date'],
          spin: ['#', 'User', 'Email', 'Prize', 'Reward (Gh)', 'Result', 'Status', 'Date'],
          memory: ['#', 'User', 'Email', 'Duration', 'Reward (Gh)', 'Result', 'Status', 'Date'],
          balance: ['#', 'User', 'Email', 'Date', 'BTC'],
        };

        const TITLES = {
          streak: '<i class="fas fa-fire text-danger me-2"></i>Streak History',
          trading: '<i class="fas fa-chart-line text-primary me-2"></i>Trading History',
          spin: '<i class="fas fa-dharmachakra text-warning me-2"></i>Spin Wheel History',
          memory: '<i class="fas fa-brain text-info me-2"></i>Memory Match History',
          balance: '<i class="fas fa-wallet text-info me-2"></i>Balance History',
        };

        function colKey() {
          if (state.tab === 'game') return state.gameType;
          if (state.tab === 'mining') return 'balance';
          return state.tab;
        }

        /* ── helpers ────────────────────────────────────────────────────── */
        function badge(color, text) { return `<span class="badge bg-${color}">${text}</span>`; }
        function fmtDate(ts) { return ts ? new Date(ts).toLocaleString() : '-'; }
        function fmtPrice(n) { return n != null ? '$' + Number(n).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '-'; }
        function fmtCrypto(n) { return n != null ? Number(n).toFixed(18) : '-'; }

        /* ── row builders ────────────────────────────────────────────────── */
        function buildRow(rec, idx) {
          const n = (state.page - 1) * state.limit + idx + 1;
          const name = rec.userName || '-';
          const email = rec.userEmail || '-';

          if (state.tab === 'streak') {
            const d = rec.streakDays || 0;
            return `<tr><td>${n}</td><td>${name}</td><td>${email}</td>
        <td>${d} days</td>
        <td>${rec.streakLastDate || '-'}</td>
        <td class="text-nowrap">${rec.updatedAt ? new Date(rec.updatedAt).toLocaleDateString() : '-'}</td></tr>`;
          }

          if (state.tab === 'game' && state.gameType === 'trading') {
            return `<tr><td>${n}</td><td>${name}</td><td>${email}</td>
        <td>${rec.direction === 'up' ? badge('success', '▲ Up') : badge('danger', '▼ Down')}</td>
        <td>${rec.durationLabel || '-'}</td>
        <td class="text-nowrap">${fmtPrice(rec.entryPrice)}</td>
        <td class="text-nowrap">${fmtPrice(rec.exitPrice)}</td>
        <td>${rec.won ? badge('success', 'Won') : badge('danger', 'Lost')}</td>
        <td>${rec.miningGh || 0} Gh</td>
        <td>${rec.claimed ? badge('success', 'Claimed') : badge('secondary', 'Pending')}</td>
        <td class="text-nowrap">${fmtDate(rec.earnedAt)}</td></tr>`;
          }

          if (state.tab === 'game' && state.gameType === 'spin') {
            const st = rec.status === 'claimed' ? badge('success', 'claimed') : rec.status === 'won_pending' ? badge('warning', 'pending') : badge('danger', rec.status || '-');
            return `<tr><td>${n}</td><td>${name}</td><td>${email}</td>
        <td>${rec.label || '-'}</td><td>${rec.gh || 0} Gh</td>
        <td>${rec.status === 'lose' ? badge('danger', 'Lost') : badge('success', 'Won')}</td>
        <td>${st}</td>
        <td class="text-nowrap">${fmtDate(rec.ts)}</td></tr>`;
          }

          if (state.tab === 'game' && state.gameType === 'memory') {
            const st = rec.status === 'claimed' ? badge('success', 'claimed') : rec.status === 'won_pending' ? badge('warning', 'pending') : badge('danger', rec.status || '-');
            return `<tr><td>${n}</td><td>${name}</td><td>${email}</td>
        <td>${rec.durationSec || 0}s</td><td>${rec.gh || 0} Gh</td>
        <td>${rec.won ? badge('success', 'Won') : badge('danger', 'Lost')}</td>
        <td>${st}</td>
        <td class="text-nowrap">${fmtDate(rec.ts)}</td></tr>`;
          }

          if (state.tab === 'mining') {
            return `<tr><td>${n}</td><td>${name}</td><td>${email}</td>
        <td class="text-nowrap">${fmtDate(rec.date)}</td>
        <td>${fmtCrypto(rec.BTC)}</td>
      </tr>`;
          }
          return '';
        }

        /* ── render ─────────────────────────────────────────────────────── */
        function showSpinner() {
          document.getElementById('histTableWrap').innerHTML =
            '<div class="hist-spinner"><div class="spinner-border spinner-border-sm" role="status"></div> Loading…</div>';
          document.getElementById('histPagination').innerHTML = '';
          document.getElementById('histCount').textContent = '';
        }

        function renderTable(data) {
          const wrap = document.getElementById('histTableWrap');
          document.getElementById('histTitle').innerHTML = TITLES[colKey()] || 'History';

          if (!data.records || data.records.length === 0) {
            wrap.innerHTML = '<div class="hist-empty"><i class="fas fa-inbox fa-2x mb-2 d-block"></i>No records found</div>';
            document.getElementById('histPagination').innerHTML = '';
            document.getElementById('histCount').textContent = '';
            return;
          }

          const ths = COLS[colKey()].map(c => `<th>${c}</th>`).join('');
          const trs = data.records.map((r, i) => buildRow(r, i)).join('');

          wrap.innerHTML = `
      <table class="table table-dark table-striped table-hover table-bordered align-middle" id="histTable">
        <thead><tr>${ths}</tr></thead>
        <tbody>${trs}</tbody>
      </table>`;

          document.getElementById('histCount').textContent = `Page ${data.page}`;

          renderPagination(data);
        }

        function renderPagination(data) {
          const pg = document.getElementById('histPagination');
          pg.innerHTML = '';
          if (data.page === 1 && !data.hasMore) return;

          if (data.page > 1) {
            const a = document.createElement('a');
            a.href = 'javascript:void(0)';
            a.className = 'btn btn-outline-primary me-2';
            a.textContent = 'Prev';
            a.addEventListener('click', () => { state.page--; load(); });
            pg.appendChild(a);
          }

          const info = document.createElement('span');
          info.className = 'me-2';
          info.textContent = `Page ${data.page}`;
          pg.appendChild(info);

          if (data.hasMore) {
            const a = document.createElement('a');
            a.href = 'javascript:void(0)';
            a.className = 'btn btn-outline-primary ms-2';
            a.textContent = 'Next';
            a.addEventListener('click', () => { state.page++; load(); });
            pg.appendChild(a);
          }
        }

        /* ── fetch ───────────────────────────────────────────────────────── */
        async function load() {
          showSpinner();
          const params = new URLSearchParams({
            tab: state.tab, gameType: state.gameType, miningType: state.miningType,
            page: state.page, limit: state.limit, q: state.q,
          });
          try {
            const res = await fetch(`/admin/history/api?${params}`, { credentials: 'same-origin' });
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            renderTable(await res.json());
          } catch (err) {
            document.getElementById('histTableWrap').innerHTML =
              `<div class="hist-empty text-danger"><i class="fas fa-exclamation-triangle me-1"></i>Failed to load: ${err.message}</div>`;
          }
        }

        /* ── tab switching ───────────────────────────────────────────────── */
        document.querySelectorAll('.history-tab-link').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.history-tab-link').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            state.tab = btn.dataset.tab;
            state.page = 1;
            document.getElementById('gameSubTabs').style.display = state.tab === 'game' ? 'flex' : 'none';
            load();
          });
        });

        /* ── game sub-tab switching ──────────────────────────────────────── */
        const gamePillColors = { trading: 'primary', spin: 'warning', memory: 'info' };
        document.querySelectorAll('.game-pill').forEach(btn => {
          btn.addEventListener('click', () => {
            const gt = btn.dataset.gtype;
            document.querySelectorAll('.game-pill').forEach(b => {
              b.className = `btn btn-sm btn-outline-${gamePillColors[b.dataset.gtype]} game-pill`;
            });
            btn.className = `btn btn-sm btn-${gamePillColors[gt]} game-pill`;
            state.gameType = gt;
            state.page = 1;
            load();
          });
        });

        /* ── mining sub-tab switching ────────────────────────────────────── */
        const miningPillColors = { sessions: 'success', balance: 'info' };
        document.querySelectorAll('.mining-pill').forEach(btn => {
          btn.addEventListener('click', () => {
            const mt = btn.dataset.mtype;
            document.querySelectorAll('.mining-pill').forEach(b => {
              b.className = `btn btn-sm btn-outline-${miningPillColors[b.dataset.mtype]} mining-pill`;
            });
            btn.className = `btn btn-sm btn-${miningPillColors[mt]} mining-pill`;
            state.miningType = mt;
            state.page = 1;
            load();
          });
        });

        /* ── search ──────────────────────────────────────────────────────── */
        const searchInput = document.getElementById('userSearch');
        const clearBtn = document.getElementById('histSearchClear');

        searchInput.addEventListener('input', () => {
          clearBtn.style.display = searchInput.value ? '' : 'none';
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => { state.q = searchInput.value.trim(); state.page = 1; load(); }, 350);
        });

        searchInput.addEventListener('keydown', e => {
          if (e.key === 'Enter') { clearTimeout(debounceTimer); state.q = searchInput.value.trim(); state.page = 1; load(); }
        });

        clearBtn.addEventListener('click', () => {
          searchInput.value = ''; clearBtn.style.display = 'none';
          state.q = ''; state.page = 1; load();
        });

        /* ── boot ────────────────────────────────────────────────────────── */
        load();
      })();
    </script>

    <%- include('partials/footer') %>