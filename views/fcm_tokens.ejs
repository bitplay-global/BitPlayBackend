<%- include('partials/header', { title }) %>
<%- include('partials/sidebar', { user }) %>

<div class="main-content">
  <div id="loading" style="display: none;">Searching...</div>

  <div class="card-container">
    <div class="cards">
      <div class="card-header">
        <h2>Send a Notification</h2>
      </div>
      <div style="padding: 16px;">
        <p style="opacity:.75; margin-bottom: 16px;">
          <%= totalTokens %> registered device<%= totalTokens === 1 ? '' : 's' %> can receive push notifications.
        </p>
        <div class="row g-2 align-items-end">
          <div class="col-md-4">
            <label class="form-label">Title</label>
            <input type="text" id="broadcastTitle" class="form-control" placeholder="e.g. New feature available!" maxlength="100" />
          </div>
          <div class="col-md-5">
            <label class="form-label">Message</label>
            <input type="text" id="broadcastBody" class="form-control" placeholder="e.g. Check out the new Super Privileges store." maxlength="240" />
          </div>
          <div class="col-md-3">
            <button class="btn btn-primary w-100" onclick="sendBroadcast()">
              <i class="fas fa-bullhorn"></i> Send to All Users
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card-container">
    <div class="cards">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h2>Firebase FCM Tokens</h2>
        <input
          type="text"
          id="tokenSearch"
          class="form-control"
          placeholder="Search by user ID or token..."
          value="<%= searchQuery %>"
          style="max-width: 300px;"
        />
      </div>

      <div class="table-responsive data-table" id="tokensTableContainer">
        <table class="table table-dark table-striped table-hover table-bordered align-middle">
          <thead>
            <tr>
              <th>#</th>
              <th>User ID</th>
              <th>Token</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="tokensTbody">
            <% tokens.forEach((row, index) => { %>
              <tr>
                <td><%= (page - 1) * limit + index + 1 %></td>
                <td><%= row.user_id %></td>
                <td style="max-width:400px; word-break:break-all;"><%= row.token %></td>
                <td>
                  <button class="btn btn-sm btn-outline-primary" onclick="openSendModal('<%= row.user_id %>')">
                    <i class="fas fa-paper-plane"></i> Send
                  </button>
                  <button class="btn btn-sm btn-outline-danger" onclick="deleteToken('<%= row._id %>')">
                    <i class="fas fa-trash"></i> Delete
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="pagination mt-3 d-flex align-items-center">
        <% if (page > 1) { %>
          <a href="?page=<%= page - 1 %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="btn btn-outline-primary me-2">Prev</a>
        <% } %>

        <span class="me-2">Page <%= page %></span>

        <% if (tokens.length === limit) { %>
          <a href="?page=<%= page + 1 %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="btn btn-outline-primary ms-2">Next</a>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Send-to-one-user modal -->
<div class="modal fade" id="sendModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Send Notification</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>To user: <strong id="sendModalUserId"></strong></p>
        <div class="mb-3">
          <label class="form-label">Title</label>
          <input type="text" id="sendModalTitle" class="form-control" maxlength="100" />
        </div>
        <div class="mb-3">
          <label class="form-label">Message</label>
          <input type="text" id="sendModalBody" class="form-control" maxlength="240" />
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="sendToUser()">
          <i class="fas fa-paper-plane"></i> Send
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const searchInput = document.getElementById('tokenSearch');
  const tokensTbody = document.getElementById('tokensTbody');
  let searchTimeout;

  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimeout);

    searchTimeout = setTimeout(async () => {
      const query = searchInput.value.trim();
      try {
        const response = await fetch(`/admin/fcm?q=${encodeURIComponent(query)}&page=1`, {
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });

        const data = await response.json();
        tokensTbody.innerHTML = '';

        if (data.tokens.length === 0) {
          tokensTbody.innerHTML = '<tr><td colspan="4">No records found</td></tr>';
          return;
        }

        data.tokens.forEach((row, index) => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td>${index + 1}</td>
            <td>${row.user_id}</td>
            <td style="max-width:400px; word-break:break-all;">${row.token}</td>
            <td>
              <button class="btn btn-sm btn-outline-primary" onclick="openSendModal('${row.user_id}')">
                <i class="fas fa-paper-plane"></i> Send
              </button>
              <button class="btn btn-sm btn-outline-danger" onclick="deleteToken('${row._id}')">
                <i class="fas fa-trash"></i> Delete
              </button>
            </td>
          `;
          tokensTbody.appendChild(tr);
        });
      } catch (err) {
        console.error('Search failed:', err);
      }
    }, 300);
  });

  async function deleteToken(id) {
    if (!confirm('Delete this token?')) return;

    try {
      const res = await fetch(`/api/fcm/${id}`, { method: 'DELETE' });
      const result = await res.json();

      if (result.success) {
        location.reload();
      } else {
        alert(result.message);
      }
    } catch (e) {
      console.error('Failed to delete:', e);
    }
  }

  let sendModalInstance;
  function openSendModal(userId) {
    document.getElementById('sendModalUserId').textContent = userId;
    document.getElementById('sendModalTitle').value = '';
    document.getElementById('sendModalBody').value = '';
    sendModalInstance = sendModalInstance || new bootstrap.Modal(document.getElementById('sendModal'));
    sendModalInstance.show();
  }

  async function sendToUser() {
    const user_id = document.getElementById('sendModalUserId').textContent;
    const title = document.getElementById('sendModalTitle').value.trim();
    const body = document.getElementById('sendModalBody').value.trim();

    if (!title || !body) {
      alert('Title and message are both required.');
      return;
    }

    try {
      const res = await fetch('/admin/notifications/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ user_id, title, body }),
      });
      const result = await res.json();
      alert(result.success ? 'Notification sent.' : `Failed: ${result.message}`);
      if (result.success) sendModalInstance.hide();
    } catch (e) {
      console.error('Failed to send:', e);
      alert('Failed to send notification.');
    }
  }

  async function sendBroadcast() {
    const title = document.getElementById('broadcastTitle').value.trim();
    const body = document.getElementById('broadcastBody').value.trim();

    if (!title || !body) {
      alert('Title and message are both required.');
      return;
    }
    if (!confirm(`Send this to ALL <%= totalTokens %> registered device(s)?`)) return;

    try {
      const res = await fetch('/admin/notifications/send-all', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, body }),
      });
      // A timeout or an expired login returns an HTML page, not JSON. Say which,
      // rather than a bare "failed".
      let result;
      try {
        result = await res.json();
      } catch (_) {
        const why = res.redirected || res.url.includes('/admin/login')
          ? 'your admin session has expired -- please log in again'
          : `the server answered HTTP ${res.status}`;
        alert(`Failed to send broadcast: ${why}.`);
        return;
      }
      if (result.success) {
        alert(`Broadcast queued for ${result.queued} device(s). Sends happen in the background -- check the admin-panel server log for final delivery counts.`);
      } else {
        alert(`Failed: ${result.message}`);
      }
    } catch (e) {
      console.error('Failed to broadcast:', e);
      alert('Failed to send broadcast.');
    }
  }
</script>

<%- include('partials/footer') %>
