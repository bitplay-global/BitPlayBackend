  </main>
</div> <!-- /.main-content -->
</div> <!-- /.admin-container -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // Future dates are not selectable in any calendar in the admin panel. Uses the
  // browser's local date so "today" matches what the admin sees on their clock.
  (function () {
    var now = new Date();
    var pad = function (n) { return String(n).padStart(2, '0'); };
    var today = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());
    var nowLocal = today + 'T' + pad(now.getHours()) + ':' + pad(now.getMinutes());
    document.querySelectorAll('input[type="date"]').forEach(function (el) { el.max = today; });
    document.querySelectorAll('input[type="datetime-local"]').forEach(function (el) { el.max = nowLocal; });
  })();
</script>
