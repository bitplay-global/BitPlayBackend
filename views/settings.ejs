<%- include('partials/header', { title: 'Settings' }) %>
<%- include('partials/sidebar', { user }) %>

<div class="main-content p-4 text-light">
  <h2 class="mb-4">System Settings</h2>

  <% if (typeof settingsMessage !== 'undefined' && settingsMessage) { %>
  <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
    <%= settingsMessage %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  <% } %>
  <% if (typeof settingsError !== 'undefined' && settingsError) { %>
  <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
    <%= settingsError %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  <% } %>

  <div class="settings-card bg-dark rounded-4 p-4 mb-4 shadow-lg" style="background: linear-gradient(135deg, #0f172a, #1e293b);">
    <h5 class="text-white mb-3"><i class="fas fa-money-bill-wave me-2"></i>Withdrawal Limits (BTC)</h5>
    <p class="text-muted small mb-3">Min and max withdrawal amounts in BTC. Used by the app and API for validation.</p>
    <form method="POST" action="/admin/settings/withdrawal-limits" class="row g-3 align-items-end">
      <div class="col-md-4">
        <label class="form-label text-white">Min withdrawal (BTC)</label>
        <input type="number" step="any" min="0" name="withdrawalMinBtc" class="form-control bg-dark text-light border-secondary"
          value="<%= typeof withdrawalMinBtc !== 'undefined' ? withdrawalMinBtc : 0.0005 %>" required>
      </div>
      <div class="col-md-4">
        <label class="form-label text-white">Max withdrawal (BTC)</label>
        <input type="number" step="any" min="0" name="withdrawalMaxBtc" class="form-control bg-dark text-light border-secondary"
          value="<%= typeof withdrawalMaxBtc !== 'undefined' ? withdrawalMaxBtc : 0.009 %>" required>
      </div>
      <div class="col-md-4">
        <button type="submit" class="btn btn-primary">Save limits</button>
      </div>
    </form>
  </div>
