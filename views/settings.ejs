  <!-- AdMob API (OAuth – no service account, refresh token from Settings) -->
  <div class="settings-card bg-dark rounded-4 p-4 mb-4 shadow-lg" style="background: linear-gradient(135deg, #0f172a, #1e293b);">
    <h5 class="text-white mb-3"><i class="fas fa-chart-line me-2"></i>AdMob API (Dashboard revenue)</h5>
    <p class="text-muted small mb-3">Uses your Google account. Tokens are stored here and refreshed automatically; re-authorize only if refresh fails.</p>
    <% if (typeof admobConfigured !== 'undefined' && admobConfigured) { %>
    <p class="text-success mb-2"><i class="fas fa-check-circle me-2"></i>Connected. Dashboard will fetch AdMob revenue (iOS/Android) using stored tokens.</p>
    <% } else { %>
    <p class="text-warning mb-2"><i class="fas fa-exclamation-triangle me-2"></i>Not connected. Connect below to show AdMob revenue on the dashboard.</p>
    <% } %>
    <div class="row g-3 align-items-end">
      <% if (typeof admobAuthUrl !== 'undefined' && admobAuthUrl) { %>
      <div class="col-md-4">
        <a href="<%= admobAuthUrl %>" class="btn btn-primary"><i class="fab fa-google me-2"></i>Connect with Google</a>
      </div>
      <% } %>
      <div class="col-md-8">
        <form method="POST" action="/admin/settings/admob-tokens" class="row g-2 align-items-end">
          <div class="col-auto">
            <label class="form-label text-white small mb-0">Or paste refresh token</label>
            <input type="password" name="refresh_token" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="1//0e..." style="min-width: 220px;">
          </div>
          <div class="col-auto">
            <input type="text" name="access_token" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Access token (optional)" style="min-width: 180px;">
          </div>
          <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary btn-sm">Save tokens</button>
          </div>
        </form>
      </div>
    </div>
    <p class="text-muted small mt-2 mb-0">Set ADMOB_ACCOUNT_ID, ADMOB_CLIENT_ID, and ADMOB_CLIENT_SECRET in .env. In Google Cloud Console, add this <strong>exact</strong> redirect URI: <code class="text-info"><%= typeof admobAuthUrl !== 'undefined' && admobAuthUrl ? admobAuthUrl.replace('/auth','/callback') : 'http://localhost:3001/admin/admob/callback' %></code></p>
    <p class="text-muted small mt-1 mb-0"><a href="/admin/admob/status" target="_blank" rel="noopener">Check AdMob status (debug)</a> — shows configured, hasTokens, and a test revenue fetch or error.</p>
  </div>

  <div class="settings-card bg-dark rounded-4 p-4 mb-4 shadow-lg" style="background: linear-gradient(135deg, #0f172a, #1e293b);">
    <div class="row g-3">
      <div class="col-md-6">
        <div class="setting-item p-3 bg-gradient rounded-3" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
          <h5 class="text-white mb-2">Site Name</h5>
          <p class="text-muted mb-0">Bitcoin Mining Admin Panel</p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="setting-item p-3 bg-gradient rounded-3" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
          <h5 class="text-white mb-2">Database Connection</h5>
          <p class="text-success mb-0"><i class="fas fa-check-circle me-2"></i>MongoDB Atlas - Connected</p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="setting-item p-3 bg-gradient rounded-3" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
          <h5 class="text-white mb-2">Session Timeout</h5>
          <p class="text-muted mb-0">24 hours</p>
        </div>
      </div>
      <!-- <div class="col-md-6">
        <div class="setting-item p-3 bg-gradient rounded-3" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
          <h5 class="text-white mb-2">Default Password</h5>
          <p class="text-muted mb-0">admin@123</p>
        </div>
      </div> -->
      <div class="col-md-6">
        <div class="setting-item p-3 bg-gradient rounded-3" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
          <h5 class="text-white mb-2">Server Status</h5>
          <p class="text-success mb-0"><i class="fas fa-server me-2"></i>Running on Port 3001</p>
        </div>
      </div>
      <!-- <div class="col-md-6">
        <div class="setting-item p-3 bg-gradient rounded-3" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
          <h5 class="text-white mb-2">Environment</h5>
          <p class="text-warning mb-0"><i class="fas fa-code me-2"></i>Development Mode</p>
        </div>
      </div> -->
    </div>
  </div>
</div>

<%- include('partials/footer') %>
