<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - DashPro Admin</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <nav class="sidebar">
            <div class="sidebar-header">
                <h2>DashPro</h2>
            </div>
            <ul class="sidebar-menu">
                <li>
                    <a href="/dashboard">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="/users">
                        <i class="fas fa-users"></i>
                        <span>Users</span>
                    </a>
                </li>
                <li>
                    <a href="/transactions">
                        <i class="fas fa-credit-card"></i>
                        <span>Transactions</span>
                    </a>
                </li>
                <li class="active">
                    <a href="/support">
                        <i class="fas fa-headset"></i>
                        <span>Support</span>
                    </a>
                </li>
                <li>
                    <a href="/settings">
                        <i class="fas fa-cog"></i>
                        <span>Settings</span>
                    </a>
                </li>
                <li>
                    <a href="/logout">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Logout</span>
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Header -->
            <header class="header">
                <div class="header-left">
                    <h1>Support Tickets</h1>
                </div>
                <div class="header-right">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Search tickets...">
                    </div>
                    <div class="user-info">
                        <i class="fas fa-user-circle"></i>
                        <span>Hello, <%= user %>!</span>
                    </div>
                </div>
            </header>

            <!-- Support Content -->
            <main class="page-content">
                <% if (typeof error !== 'undefined' && error) { %>
                <div class="error-message">
                    <i class="fas fa-exclamation-circle"></i>
                    <%= error %>
                </div>
                <% } %>

                <div class="support-container">
                    <div class="support-header">
                        <h3>All Support Tickets</h3>
                        <div class="support-filters">
                            <select class="filter-select">
                                <option value="all">All Priority</option>
                                <option value="high">High</option>
                                <option value="medium">Medium</option>
                                <option value="low">Low</option>
                            </select>
                            <select class="filter-select">
                                <option value="all">All Status</option>
                                <option value="open">Open</option>
                                <option value="in-progress">In Progress</option>
                                <option value="resolved">Resolved</option>
                                <option value="closed">Closed</option>
                            </select>
                        </div>
                    </div>

                    <div class="support-table">
                        <table>
                            <thead>
                                <tr>
                                    <th>Ticket ID</th>
                                    <th>Subject</th>
                                    <th>User</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                    <th>Created</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (tickets && tickets.length > 0) { %>
                                    <% tickets.forEach(function(ticket) { %>
                                    <tr>
                                        <td>#<%= ticket.id %></td>
                                        <td><%= ticket.subject %></td>
                                        <td><%= ticket.user %></td>
                                        <td>
                                            <span class="priority <%= ticket.priority %>">
                                                <%= ticket.priority %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="status <%= ticket.status %>">
                                                <%= ticket.status %>
                                            </span>
                                        </td>
                                        <td><%= new Date(ticket.createdAt).toLocaleDateString() %></td>
                                        <td>
                                            <div class="action-buttons">
                                                <button class="btn-action view" onclick="viewTicket('<%= ticket.id %>')">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <button class="btn-action edit" onclick="updateTicket('<%= ticket.id %>')">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }); %>
                                <% } else { %>
                                    <!-- Sample data when no tickets -->
                                    <tr>
                                        <td>#001</td>
                                        <td>Login Issues</td>
                                        <td>John Doe</td>
                                        <td><span class="priority high">High</span></td>
                                        <td><span class="status open">Open</span></td>
                                        <td><%= new Date().toLocaleDateString() %></td>
                                        <td>
                                            <div class="action-buttons">
                                                <button class="btn-action view">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <button class="btn-action edit">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>#002</td>
                                        <td>Payment Failed</td>
                                        <td>Jane Smith</td>
                                        <td><span class="priority medium">Medium</span></td>
                                        <td><span class="status in-progress">In Progress</span></td>
                                        <td><%= new Date().toLocaleDateString() %></td>
                                        <td>
                                            <div class="action-buttons">
                                                <button class="btn-action view">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <button class="btn-action edit">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>#003</td>
                                        <td>Feature Request</td>
                                        <td>Mike Johnson</td>
                                        <td><span class="priority low">Low</span></td>
                                        <td><span class="status resolved">Resolved</span></td>
                                        <td><%= new Date().toLocaleDateString() %></td>
                                        <td>
                                            <div class="action-buttons">
                                                <button class="btn-action view">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <button class="btn-action edit">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="/js/script.js"></script>
    <script>
        function viewTicket(ticketId) {
            console.log('View ticket:', ticketId);
        }

        function updateTicket(ticketId) {
            console.log('Update ticket:', ticketId);
        }
    </script>
</body>
</html>
